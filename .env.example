# PostgreSQL 16 + pgvector
POSTGRES_DB=foodshop
POSTGRES_USER=foodshop
POSTGRES_PASSWORD=foodshop_dev_pwd
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible storage in RF cloud / local dev)
MINIO_ROOT_USER=foodshop_minio
MINIO_ROOT_PASSWORD=foodshop_minio_pwd
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_CATALOG_FEEDS=catalog-feeds
S3_BUCKET_WEBHOOK_ARCHIVE=webhook-raw-archive

# Kafka (KRaft)
KAFKA_PORT=9092

# ClickHouse (analytics & A/B events)
CLICKHOUSE_DB=foodshop_analytics
CLICKHOUSE_USER=foodshop_ch
CLICKHOUSE_PASSWORD=foodshop_ch_pwd
CLICKHOUSE_HTTP_PORT=8123

# Services
CORE_API_PORT=8080
SOLVER_SVC_PORT=8000
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
SENTRY_DSN=
